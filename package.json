{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Learn every country, capital and flag in the world.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "data": "node scripts/build-countries.mjs && node scripts/build-geo.mjs && node scripts/build-flags.mjs && node scripts/build-adjacency.mjs && node scripts/build-states.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "4.135.0"
  }
}
